# Copy to repo-root .env and fill in. Never commit the real .env (gitignored).

# === Grafana Cloud ===
OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTLP_INSTANCE_ID=000000
OTLP_TOKEN=glc_xxx
GRAFANA_URL=https://YOURSTACK.grafana.net
GRAFANA_MCP_TOKEN=glsa_xxx

# === Google Cloud / Gemini (Vertex AI) ===
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_MODEL=gemini-2.5-flash
